{
  "uid": "petclinic-bluegreen",
  "title": "PetClinic Blue vs Green",
  "description": "Fase 3: versión activa y preview lado a lado durante un despliegue blue-green.",
  "tags": [
    "petclinic",
    "aiops",
    "bluegreen"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "15s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "version",
        "label": "Versión",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_requests_seconds_count{namespace=\"petclinic\"}, version)",
          "refId": "v"
        },
        "definition": "label_values(http_server_requests_seconds_count{namespace=\"petclinic\"}, version)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "route",
        "label": "Ruta",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(http_server_requests_seconds_count{namespace=\"petclinic\", uri!~\"/actuator.*|/webjars.*|/resources.*|/oups|UNKNOWN|/\\\\*\\\\*\"}, uri)",
          "refId": "r"
        },
        "definition": "label_values(http_server_requests_seconds_count{namespace=\"petclinic\"}, uri)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Eventos del Rollout",
        "datasource": {
          "type": "loki",
          "uid": "loki"
        },
        "enable": true,
        "iconColor": "orange",
        "expr": "{job=\"loki.source.kubernetes_events\", namespace=\"petclinic\"} |= \"kind=Rollout\" | logfmt",
        "textFormat": "{{reason}}",
        "instant": false
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Solicitudes por segundo",
      "description": "Tráfico que recibe cada versión (k6 envía lo mismo a active y preview). Excluye /actuator.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (version) (rate(http_server_requests_seconds_count{namespace=\"petclinic\", version=~\"$version\", uri!~\"/actuator.*\"}[1m]))",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "% de errores 5xx",
      "description": "Respuestas 5xx sobre el total. /oups se excluye porque es un error provocado a propósito.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (sum by (version) (rate(http_server_requests_seconds_count{namespace=\"petclinic\", version=~\"$version\", uri!~\"/actuator.*\", status=~\"5..\", uri!=\"/oups\"}[1m])) or sum by (version) (rate(http_server_requests_seconds_count{namespace=\"petclinic\", version=~\"$version\", uri!~\"/actuator.*\", uri!=\"/oups\"}[1m])) * 0) / sum by (version) (rate(http_server_requests_seconds_count{namespace=\"petclinic\", version=~\"$version\", uri!~\"/actuator.*\", uri!=\"/oups\"}[1m]))",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Latencia p95 por ruta",
      "description": "Calculada con los histogramas de Spring Boot (percentiles-histogram). Ventana de 2 min.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (version, uri, le) (rate(http_server_requests_seconds_bucket{namespace=\"petclinic\", version=~\"$version\", uri!~\"/actuator.*\", uri=~\"$route\", uri!~\"/oups|/webjars.*|/resources.*\"}[2m])))",
          "legendFormat": "{{version}} · {{uri}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Latencia p99 por ruta",
      "description": "Calculada con los histogramas de Spring Boot (percentiles-histogram). Ventana de 2 min.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 9
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (version, uri, le) (rate(http_server_requests_seconds_bucket{namespace=\"petclinic\", version=~\"$version\", uri!~\"/actuator.*\", uri=~\"$route\", uri!~\"/oups|/webjars.*|/resources.*\"}[2m])))",
          "legendFormat": "{{version}} · {{uri}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Heap usado (promedio por pod)",
      "description": "Un crecimiento sostenido después del calentamiento puede indicar una fuga.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (version) (sum by (version, pod) (jvm_memory_used_bytes{namespace=\"petclinic\", version=~\"$version\", area=\"heap\"}))",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Pausas de GC",
      "description": "Segundos de pausa por segundo, sumando los pods de cada versión.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 8,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (version) (rate(jvm_gc_pause_seconds_sum{namespace=\"petclinic\", version=~\"$version\"}[1m]))",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Pool de conexiones (Hikari)",
      "description": "Conexiones en espera mayores que 0 indican que el pool se agotó (escenario de la consulta lenta).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 16,
        "y": 17,
        "w": 8,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (version) (hikaricp_connections_active{namespace=\"petclinic\", version=~\"$version\"})",
          "legendFormat": "activas · {{version}}"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (version) (hikaricp_connections_pending{namespace=\"petclinic\", version=~\"$version\"})",
          "legendFormat": "en espera · {{version}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "CPU del proceso (promedio por pod)",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 8,
            "showPoints": "never",
            "stacking": {
              "mode": "none"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "avg by (version) (process_cpu_usage{namespace=\"petclinic\", version=~\"$version\"})",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "stat",
      "title": "Puntaje del analizador AIOps",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "Lo publica el analizador (equipo de IA) como métrica aiops_analyzer_score{version}. Umbral inicial: 75.",
      "gridPos": {
        "x": 12,
        "y": 25,
        "w": 12,
        "h": 7
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "max": 100,
          "noValue": "Pendiente: lo publica el analizador",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 75
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "textMode": "value_and_name",
        "graphMode": "none"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "aiops_analyzer_score{version=~\"$version\"}",
          "legendFormat": "{{version}}"
        }
      ]
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Logs de error por versión (Loki)",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 10
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{namespace=\"petclinic\", app=\"petclinic\", version=~\"$version\", level=\"ERROR\"} | json | line_format \"[{{.version}}] {{.error_type}}: {{.message}}\""
        }
      ]
    }
  ]
}